                  <items count="12">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas.data import json_load
from compas_rhino.conversions import frame_to_rhino_plane

fp = r"C:\Users\jk6372\Desktop\00_princeton_projects\00_robotic_territories\00_git\compas_xr_robotic_territories\dev\performance_operations\robots\com_handlers\realtime_mimic_data_storage.json"
#fp = r"C:\Users\jk6372\Desktop\00_princeton_projects\00_robotic_territories\00_git\compas_xr_robotic_territories\dev\performance_operations\robots\com_handlers\realtime_mimic_data_storage_long.json"
#fp = r"C:\Users\jk6372\Desktop\00_princeton_projects\00_robotic_territories\00_git\compas_xr_robotic_territories\dev\performance_operations\robots\com_handlers\realtime_mimic_data_storage_short.json"

data = json_load(fp)

first_index = data[0]
print first_index.keys()
intial_ik = first_index["initial_ik_solutions"]
print (len(intial_ik))
current_config = first_index["current_config"]
current_tcp = first_index["current_tcp"]
current_tcp_plane = frame_to_rhino_plane(current_tcp)
initial_frames = first_index["initial_request_frames_list"]
initial_planes = [frame_to_rhino_plane(frame) for frame in initial_frames]
requested_robot_frame = first_index["requested_robot_frame"]
requested_robot_plane = frame_to_rhino_plane(requested_robot_frame)
computed_ik = first_index["computed_ik"]</item>

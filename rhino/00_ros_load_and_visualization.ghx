                  <items count="12">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from compas.data import json_load
from compas_rhino.conversions import frame_to_rhino_plane

fp = r"C:\Users\jk6372\Desktop\00_princeton_projects\00_robotic_territories\00_git\compas_xr_robotic_territories\dev\performance_operations\robots\com_handlers\planning_frames_debug.json"
data = json_load(fp)
ctf = frame_to_rhino_plane(data["current_tool_frame"])
clostf = frame_to_rhino_plane(data["closest_target_frame"])
tran_t = frame_to_rhino_plane(data["transformed_target"])
exit_s = frame_to_rhino_plane(data["exit_safe_frame"])
pick = frame_to_rhino_plane(data["pick_frame"])
app_pick = frame_to_rhino_plane(data["approach_pick_frame"])
place = frame_to_rhino_plane(data["place_frame"])
app_place = frame_to_rhino_plane(data["approach_place_frame"])
#        data["completed_items_dict"] = transformed_completed_items_dict
#        data["incompleted_items_dict"] = transformed_incompleted_items_dict
#        data["colsest_target_name"] = closest_target_name
</item>

fp3 = r"C:\Users\jk6372\Desktop\00_princeton_projects\00_robotic_territories\00_git\compas_xr_robotic_territories\dev\python\random_config_frames.json"


test = json_load(fp)
test2 = json_load(fp2)
test3 = json_load(fp3)


a = [frame_to_rhino_plane(frame) for frame in test]
b = [Configuration.__from_data__(info) for info in test2]
c = [frame_to_rhino_plane(frame2) for frame2 in test3]</item>

            <chunk name="Object" index="165">
              <items count="3">
                <item name="GUID" type_name="gh_guid" type_code="9">410755b1-224a-4c1e-a407-bf32fb45ea7e</item>
                <item name="Lib" type_name="gh_guid" type_code="9">00000000-0000-0000-0000-000000000000</item>
                <item name="Name" type_name="gh_string" type_code="10">GhPython Script</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="12">
                    <item name="CodeInput" type_name="gh_string" type_code="10">import math
from compas_robots import Configuration

# Inputs (from GH):
# J1, J2, J3, J4, J5, J6  -&gt; sliders in [-pi, pi]
# base_config             -&gt; (optional) a Configuration; if None, use joe_start
# lower_limits, upper_limits -&gt; (optional) lists of 6 floats for joint limits

def wrap_to_pi(a):
    return (a + math.pi) % (2*math.pi) - math.pi

def clamp(v, lo, hi):
    return max(lo, min(hi, v))

# default starting config (replace with yours or feed base_config from GH)
joe_joint_names = ['shoulder_pan_joint','shoulder_lift_joint','elbow_joint','wrist_1_joint','wrist_2_joint','wrist_3_joint']
joe_joint_types = [0,0,0,0,0,0]
joe_start_values = [-0.10790457,-0.29844413,0.06922359,-1.36258329,-1.5687577,-1.64426868]

cfg0 = Configuration(
    joint_values=joe_start_values, joint_names=joe_joint_names, joint_types=joe_joint_types
)

offsets = [x, y, z, u, v, w]  # your slider values
cur = list(cfg0.joint_values)

# apply offsets and wrap to [-pi, pi]
vals = [wrap_to_pi(v + dv) for v, dv in zip(cur, offsets)]

# optionally clamp to known robot limits if provided
if 'lower_limits' in globals() and 'upper_limits' in globals() and lower_limits and upper_limits:
    vals = [clamp(v, lo, hi) for v, lo, hi in zip(vals, lower_limits, upper_limits)]

new_config = Configuration(joint_values=vals, joint_names=joe_joint_names, joint_types=joe_joint_types)

# Outputs (set GH component outputs accordingly)
OUT_Config = new_config
OUT_Angles = vals  # radians in [-pi, pi]
print OUT_Angles</item>
